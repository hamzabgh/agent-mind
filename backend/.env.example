ENVIRONMENT=development

# --- LLM provider: mock | openai | anthropic | local ---
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_MODEL_URL=

# --- Embeddings: mock | openai ---
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# --- Storage ---
DATABASE_URL=postgresql+asyncpg://hamza:hamza@localhost:5432/hamza_ai
VECTOR_BACKEND=pgvector
QDRANT_URL=

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# --- CORS (comma-separated in real .env parsing, adjust as needed) ---
ALLOWED_ORIGINS=["http://localhost:5173"]
